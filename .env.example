# Environment configuration (Task 7). Copy to .env.local and fill in; never commit real values.
# Vite exposes only variables that start with VITE_ to the browser, so nothing secret belongs here.

# The TechSphere API. Set by CI, by the grader and by every deployed build.
# Not set: the development default from the build configuration, the API kit's local server on port 4010.
VITE_API_BASE=

# Legacy pages only: our own BrandStore mock on the same origin (used when VITE_API_BASE is not set).
VITE_API_URL=

# React app (web/): see web/.env.example for its variables.
