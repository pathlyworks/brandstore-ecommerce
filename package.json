{
  "name": "brandstore",
  "version": "2.0.0-alpha.0",
  "private": true,
  "description": "BrandStore storefront. web/: the React + TypeScript app (Vite, React Router, Tailwind). The legacy static pages (ES modules in src/) stay at the root until cutover.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev -w web",
    "dev:legacy": "vite",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs dist 4173",
    "start": "node scripts/serve.mjs . 8080",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run && npm run test -w web",
    "test:legacy": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration tests/dom",
    "test:coverage": "vitest run --coverage",
    "test:node": "node --import ./tests/support/use-vitest-shim.mjs --test \"tests/unit/*.test.js\" \"tests/integration/*.test.js\"",
    "test:browser": "node tests/support/browser/run.mjs",
    "coverage:node": "node -e \"require('fs').mkdirSync('coverage',{recursive:true})\" && node --import ./tests/support/use-vitest-shim.mjs --test --experimental-test-coverage --test-coverage-include=\"src/state/**\" --test-coverage-include=\"src/utils/**\" --test-reporter=dot --test-reporter=lcov --test-reporter-destination=stdout --test-reporter-destination=coverage/lcov.info \"tests/unit/*.test.js\" \"tests/integration/*.test.js\" && node scripts/coverage-summary.mjs coverage/lcov.info",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "test:e2e": "npm run e2e",
    "mock": "node mock-server/server.mjs",
    "contract": "node scripts/contract.mjs",
    "qa": "node qa/js-rules.js && node qa/preflight.js && node qa/behaviour.js",
    "branch:check": "node scripts/check-branch.mjs",
    "check": "npm run branch:check && npm run lint && npm run format:check && npm run test:coverage && npm run build && npm run e2e && npm run e2e:journeys && npm run contract",
    "vendor": "node scripts/vendor.mjs",
    "e2e:local": "node --import ./tests/support/playwright/use-hook.mjs tests/support/playwright/run.mjs",
    "e2e:prove": "node scripts/prove-e2e.mjs",
    "e2e:journeys": "node tests/e2e/run.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "audit:legacy": "node scripts/audit-legacy.mjs",
    "api:capture": "node scripts/capture-api.mjs",
    "api:fields": "node scripts/api-field-report.mjs && node scripts/gen-observed-types-check.mjs",
    "tokens:tailwind": "node scripts/tokens-to-tailwind.mjs",
    "web:build": "npm run build -w web",
    "web:lint": "npm run lint -w web",
    "web:typecheck": "npm run typecheck -w web",
    "storybook": "npm run storybook -w web"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@vitest/coverage-v8": "^3.2.0",
    "eslint": "^10.1.0",
    "jsdom": "^26.1.0",
    "msw": "^2.7.0",
    "playwright": "^1.55.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "axios": "1.19.0"
  },
  "workspaces": [
    "web"
  ]
}
