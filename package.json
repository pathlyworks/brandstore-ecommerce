{
  "name": "brandstore",
  "version": "2.0.0-alpha.0",
  "private": true,
  "description": "BrandStore storefront. Phase 1: static site (index.html, css/, js/). Phase 2: ES-module app in src/ against the REST API in api/openapi.json.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "mock": "node mock-server/server.mjs",
    "contract": "node scripts/contract.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run branch:check && npm run lint && npm run format:check && npm run test && npm run contract",
    "branch:check": "node scripts/check-branch.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "eslint": "^10.1.0",
    "jsdom": "^26.1.0",
    "msw": "^2.7.0",
    "prettier": "^3.8.1",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
