# React app (web/) environment configuration (Task 7). Copy to web/.env.local; never commit real values.
# Only VITE_* variables reach the browser: none of them may hold a secret.

# The TechSphere API base URL, per environment:
#   development  unset -> the API kit on port 4010 (default defined in web/vite.config.ts)
#   CI / grading  the address of the API the job started (ci.yml, the grader's VITE_API_BASE)
#   preview       any value; the GitHub Pages preview answers the API in the browser (VITE_DEMO_API=1)
#   production    the real API's https address, once there is a backend
VITE_API_BASE=

# Public path the app is served from: "/" normally, "/brandstore-ecommerce/" on GitHub Pages.
VITE_BASE=/

# "1": answer the API in the browser with the MSW handlers (GitHub Pages preview only, no backend there).
VITE_DEMO_API=

# Monitoring (monitoring_plan.md). Unset: error reports and Web Vitals stay in the page (window.__monitoring)
# and the console in development. Set: they are also sent with navigator.sendBeacon to this endpoint.
VITE_MONITORING_ENDPOINT=

# Release name attached to every report (CI sets it to the tag, e.g. v2.0.0, or the commit).
VITE_RELEASE=

# "1": React's profiling build (web/scripts/profile.mjs).
VITE_PROFILE=
